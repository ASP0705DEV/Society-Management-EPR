DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/smartgate
PORT=8080
JWT_SECRET=ai-smartgate-jwt-secret-key-2026
NODE_ENV=development

# Frontend API URL (Set on Vercel to point to deployed backend, e.g. https://api.mysociety.in)
VITE_API_URL=

# Razorpay Configuration
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
VITE_RAZORPAY_KEY_ID=

# SMTP / Email OTP Configuration (Gmail / SendGrid / Amazon SES)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME="AI Smartgate Estate OS"

# Twilio SMS Telephony
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

