# ==========================================================
# AI Smartgate Estate OS - Frontend Web Client Dockerfile
# Multi-stage production build with Vite & Nginx Alpine
# ==========================================================
FROM node:22-alpine AS builder

WORKDIR /app

COPY package*.json ./
COPY tsconfig*.json ./
COPY vite.config.ts ./

RUN npm ci

COPY . .

RUN npm run build

# ==========================================================
# High-Performance Nginx Alpine Serving Layer
# ==========================================================
FROM nginx:alpine AS runner

COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
